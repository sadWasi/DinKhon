# Copy this file to "keystore.properties" in the project root (which is git-ignored)
# to sign production release APKs and Android App Bundles locally.
# NEVER commit your actual "keystore.properties" or ".jks" keystore file to Git!

storeFile=release-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=dinkhon-release-key
keyPassword=YOUR_KEY_PASSWORD_HERE
