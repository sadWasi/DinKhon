<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Liquid Glass gradient canvas -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="14"
                android:endX="94"
                android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF081426" />
                <item android:offset="0.52" android:color="#FF0C2D57" />
                <item android:offset="1.0" android:color="#FF0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top-left atmospheric glass highlight -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="32"
                android:centerY="28"
                android:gradientRadius="68"
                android:type="radial">
                <item android:offset="0.0" android:color="#2E38BDF8" />
                <item android:offset="1.0" android:color="#0038BDF8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
